#!/bin/sh
# Rock Band 3 Deluxe uses the external drive for installed songs.
game="$HOME/Games/Roms/PS3/Rock Band 3 (USA) (En,Fr,De,Es,It)"
installed="$HOME/.config/rpcs3/dev_hdd0/game/BLUS30463/USRDIR/EBOOT.BIN"
if [ ! -f "$installed" ]; then
    message="Connect and unlock EXT_MICRON before starting Rock Band 3 Deluxe."
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$message"
    else
        printf '%s\n' "$message" >&2
    fi
    exit 1
fi
# Keep the gamepad path stable when USB event devices are renumbered.
export SDL_JOYSTICK_LINUX_CLASSIC=1
# RPCS3's audio library asks PulseAudio for a fixed 25 ms buffer; this replaces it.
export PULSE_LATENCY_MSEC="${PULSE_LATENCY_MSEC:-12}"
exec "$HOME/.local/bin/rpcs3" --no-gui "$game"
